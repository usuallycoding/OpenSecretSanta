<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: the session token stays on the device it was created on. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="session.xml" />
    </device-transfer>
</data-extraction-rules>
