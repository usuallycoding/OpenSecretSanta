# Copy this file to .env and fill it in. .env is not committed; this example is.

# --- Secrets (required) ---
# Signs the access tokens. Any long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Base64 of a 32-byte key: openssl rand -base64 32
# Keep it with your other secrets: losing it makes stored temporary passwords unreadable.
DATA_ENCRYPTION_KEY=

# --- First administrator ---
# Only used while the database has no users; it can be removed from this file afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-password-of-at-least-8-characters

# --- Emails when a group is drawn (optional) ---
# Leave these empty to send no email. Needs a Resend account and a verified sending domain.
RESEND_API_KEY=
# The sender, on the verified domain: santa@mail.example.org or Open Secret Santa <santa@mail.example.org>
EMAIL_FROM=
# Where the web app is, linked from the emails (optional): https://santa.example.org
APP_URL=

# --- Push notifications (optional) ---
# Leave these empty for no push. Needs a Firebase project (README: "Push notifications").
# Name of the service-account key file inside ./secrets (a secret: it is never served or put in an image).
FCM_KEY_FILE=
# docker-compose.images.yml only: the folder that holds the key file, as a full path when it is not next to the compose file.
# SECRETS_DIR=/home/pi/santa/secrets
# The public settings of the Firebase web app and its Web Push key pair (none of them secret).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_VAPID_KEY=

# --- Which published image to run (docker-compose.images.yml; docker compose pull) ---
# latest follows the main branch; set a version such as 1.2.0 or a commit (README: "Run on a Raspberry Pi").
IMAGE_TAG=latest

# --- Ports published on this machine ---
WEB_PORT=8080
SERVER_PORT=8081

# --- Addresses as the browser sees them ---
# Where the web app finds the server, and the address the web app is opened at (allowed by the server's CORS).
# Change both when the stack is reached by another name than localhost, and use https behind TLS.
PUBLIC_SERVER_URL=http://localhost:8081
PUBLIC_WEB_ORIGIN=http://localhost:8080
